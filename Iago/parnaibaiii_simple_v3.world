<?xml version="1.0"?>
<sdf version='1.7'>
  <world name='default'>
<light name='sun' type='directional'>
  <cast_shadows>1</cast_shadows>
  <pose frame=''>0 0 15 0 -0 0</pose>
  <diffuse>1.0 1.0 1.0 1</diffuse> <!-- Ajuste a intensidade da luz difusa -->
  <specular>0.5 0.5 0.5 1</specular> <!-- Ajuste a intensidade da luz especular -->
  <attenuation>
    <range>1000</range>
    <constant>0.9</constant>
    <linear>0.01</linear>
    <quadratic>0.001</quadratic>
  </attenuation>
  <direction>-0.5 0.5 -1</direction>
</light>

    <include>
      <uri>model://ARGO_PARNAIBAIII_V3</uri>
      <name>ARGO_PARNAIBAIII_V3</name>
      <static>1</static>
    </include>


    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
  <ambient>0.5 0.5 0.5 1</ambient> <!-- Ajuste a iluminação ambiente -->
  <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-3.031365 -4.456172 2.160642 0 0.246000 1.076000</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <state world_name='default'>

      <model name='ARGO_PARNAIBAIII_V3'>
        <pose frame='world'>0 0 0 0 0 -1.570796</pose>
        <scale>1 1 1</scale>
      </model>


      <light name='sun'>
        <pose frame=''>0 0 15 0 0 0</pose>
      </light>
    </state>
  </world>
</sdf>

